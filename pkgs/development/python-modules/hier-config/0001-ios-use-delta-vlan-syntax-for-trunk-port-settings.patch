+def test_trunk_allowed_vlan_remediation_uses_add_delta() -> None:
+    """Adding one VLAN to a trunk emits an `add` delta, not a full negate+reapply."""
+    running_config = get_hconfig(
+        Platform.CISCO_IOS,
+        "interface GigabitEthernet1/0/1\n"
+        " switchport trunk allowed vlan 1-6,8,9,13,20-23,40-92,101-103,161,163,170\n",
+    )
+    generated_config = get_hconfig(
+        Platform.CISCO_IOS,
+        "interface GigabitEthernet1/0/1\n"
+        " switchport trunk allowed vlan 1-6,8,9,12,13,20-23,40-92,101-103,161,163,170\n",
+    )
+    remediation = running_config.config_to_get_to(generated_config).dump_simple()
+    assert remediation == (
+        "interface GigabitEthernet1/0/1",
+        "  switchport trunk allowed vlan add 12",
+    )
+
