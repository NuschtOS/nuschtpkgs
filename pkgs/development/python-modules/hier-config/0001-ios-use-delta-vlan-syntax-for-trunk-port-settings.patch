 from hier_config.platforms.utils import split_vlan_id_lists
 from hier_config.root import HConfig
 
 logger = getLogger(__name__)
 
+_TRUNK_VLAN_LIST_RE = r"^switchport trunk allowed vlan [0-9,\-]+$"
+_TRUNK_VLAN_LIST_NEGATED_RE = r"^no switchport trunk allowed vlan [0-9,\-]+$"
+_TRUNK_VLAN_ADD_RE = r"^switchport trunk allowed vlan add ([0-9,\-]+)$"
+
 
 def _rm_ipv6_acl_sequence_numbers(config: HConfig) -> None:
     """If there are sequence numbers in the IPv6 ACL, remove them."""
@@ -44,6 +50,107 @@ def _add_acl_sequence_numbers(config: HConfig) -> None:
                     sequence_number += 10
 
 
+def _continuation_vlans(text: str) -> tuple[int, ...] | None:
+    """Parse a `switchport trunk allowed vlan add <ids>` continuation line.
+
+    Returns ``None`` if the line isn't a continuation, or its vlan spec fails
+    to parse (e.g. a reversed range), so the caller can leave it untouched.
+    """
+    match = fullmatch(_TRUNK_VLAN_ADD_RE, text)
+    if match is None:
+        return None
+    try:
+        return expand_range(match.group(1))
+    except ValueError:
+        return None
+
+
+def _merge_trunk_allowed_vlan_continuations(config: HConfig) -> None:
+    """Fold wrapped `switchport trunk allowed vlan` lines into one line.
+
+    IOS renders a long trunk-vlan list across multiple running-config lines: a
+    base line plus one or more ``add <ids>`` continuation lines. Merging them
+    at load time lets the diff engine compare a single value per side instead
+    of an arbitrary number of fragments.
+    """
+    seen_parent_ids: set[int] = set()
+    for child in tuple(config.all_children()):
+        parent = child.parent
+        if id(parent) in seen_parent_ids:
+            continue
+        seen_parent_ids.add(id(parent))
+
+        siblings = [
+            sibling
+            for sibling in parent.children
+            if fullmatch(_TRUNK_VLAN_LIST_RE, sibling.text)
+            or fullmatch(_TRUNK_VLAN_ADD_RE, sibling.text)
+        ]
+        if len(siblings) < 2:
+            continue
+
+        base, *continuations = siblings
+        try:
+            vlans = set(expand_range(base.text.rsplit(" ", 1)[-1]))
+        except ValueError:
+            continue
+
+        continuation_ids: list[tuple[int, ...]] = []
+        for continuation in continuations:
+            ids = _continuation_vlans(continuation.text)
+            if ids is None:
+                break
+            continuation_ids.append(ids)
+        else:
+            for ids in continuation_ids:
+                vlans |= set(ids)
+            for continuation in continuations:
+                continuation.delete()
+            base.text = f"switchport trunk allowed vlan {collapse_range(sorted(vlans))}"
+
+
+def _rewrite_trunk_allowed_vlan_delta(config: HConfig) -> None:
+    """Rewrite a full trunk-vlan negate-and-reapply pair into an add/remove delta.
+
+    IOS supports incremental ``add``/``remove`` keywords for
+    ``switchport trunk allowed vlan``, so a remediation that would otherwise
+    negate the whole list and reapply a near-identical one is rewritten into
+    the minimal delta an operator would actually type.
+    """
+    for negated in tuple(config.all_children()):
+        if not fullmatch(_TRUNK_VLAN_LIST_NEGATED_RE, negated.text):
+            continue
+
+        parent = negated.parent
+        positive = parent.get_child(re_search=_TRUNK_VLAN_LIST_RE)
+        if positive is None:
+            continue
+
+        try:
+            old_vlans = set(
+                expand_range(negated.text_without_negation.rsplit(" ", 1)[-1])
+            )
+            new_vlans = set(expand_range(positive.text.rsplit(" ", 1)[-1]))
+        except ValueError:
+            continue
+
+        added = sorted(new_vlans - old_vlans)
+        removed = sorted(old_vlans - new_vlans)
+        if not added and not removed:
+            continue
+
+        negated.delete()
+        positive.delete()
+        if removed:
+            parent.add_child(
+                f"switchport trunk allowed vlan remove {collapse_range(removed)}"
+            )
+        if added:
+            parent.add_child(
+                f"switchport trunk allowed vlan add {collapse_range(added)}"
+            )
+
+
 class HConfigDriverCiscoIOS(HConfigDriverBase):
     """Driver for Cisco IOS and IOS-XE.
 
@@ -199,5 +306,9 @@ class HConfigDriverCiscoIOS(HConfigDriverBase):
                 _remove_ipv4_acl_remarks,
                 _add_acl_sequence_numbers,
                 split_vlan_id_lists,
+                _merge_trunk_allowed_vlan_continuations,
+            ],
+            post_remediation_callbacks=[
+                _rewrite_trunk_allowed_vlan_delta,
             ],
         )
