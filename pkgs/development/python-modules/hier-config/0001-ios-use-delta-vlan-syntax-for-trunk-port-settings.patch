diff --git a/hier_config/platforms/functions.py b/hier_config/platforms/functions.py
index 9637be0..3254627 100644
--- a/hier_config/platforms/functions.py
+++ b/hier_config/platforms/functions.py
@@ -1,3 +1,43 @@
+from collections.abc import Iterable
+
+_MIN_RANGE_LENGTH = 3
+
+
+def collapse_range(numbers: Iterable[int]) -> str:
+    """Collapse ints into a compact range spec, the inverse of `expand_range`.
+
+    De-duplicates and sorts the input, so ``[5, 3, 4, 3, 1]`` collapses to
+    ``"1,3-5"``. Only runs of three or more consecutive ids collapse into a
+    ``start-end`` range -- a run of exactly two is listed as ``start,end`` --
+    matching how Cisco IOS itself renders VLAN lists.
+    """
+    ordered = sorted(set(numbers))
+    if not ordered:
+        return ""
+
+    runs: list[tuple[int, int]] = []
+    start = end = ordered[0]
+    for number in ordered[1:]:
+        if number == end + 1:
+            end = number
+            continue
+        runs.append((start, end))
+        start = end = number
+    runs.append((start, end))
+
+    segments: list[str] = []
+    for run_start, run_end in runs:
+        run_length = run_end - run_start + 1
+        if run_length >= _MIN_RANGE_LENGTH:
+            segments.append(f"{run_start}-{run_end}")
+        elif run_start == run_end:
+            segments.append(str(run_start))
+        else:
+            segments.append(f"{run_start},{run_end}")
+
+    return ",".join(segments)
+
+
 def expand_range(number_range_str: str) -> tuple[int, ...]:
     """Expand ranges like ``2-5,8,22-45`` into a de-duplicated, ordered tuple.
 
