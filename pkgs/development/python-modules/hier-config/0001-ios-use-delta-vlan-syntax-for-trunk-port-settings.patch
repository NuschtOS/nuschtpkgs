+def test_trunk_allowed_vlan_add_continuation_is_merged_on_load() -> None:
+    """IOS wraps a long trunk-vlan list across an `add` continuation line in
+    its own running-config; hier_config merges it back into one canonical
+    line so the diff engine compares a single value.
+    """
+    config = get_hconfig(
+        Platform.CISCO_IOS,
+        "interface Port-channel9\n"
+        " switchport trunk allowed vlan 1,4,5,9,40-42,44-50,53,56-58,61-63,65,69,74,78\n"
+        " switchport trunk allowed vlan add 84,85,87-90,101-103,161\n",
+    )
+    interface = config.get_child(equals="interface Port-channel9")
+    assert interface is not None
+    assert [c.text for c in interface.children] == [
+        (
+            "switchport trunk allowed vlan "
+            "1,4,5,9,40-42,44-50,53,56-58,61-63,65,69,74,78,84,85,87-90,101-103,161"
+        ),
+    ]
+
+
+def test_trunk_allowed_vlan_multiple_add_continuations_are_merged_on_load() -> None:
+    """More than one `add` continuation line folds in file order."""
+    config = get_hconfig(
+        Platform.CISCO_IOS,
+        "interface Port-channel9\n"
+        " switchport trunk allowed vlan 1-3\n"
+        " switchport trunk allowed vlan add 5\n"
+        " switchport trunk allowed vlan add 7-9\n",
+    )
+    interface = config.get_child(equals="interface Port-channel9")
+    assert interface is not None
+    assert [c.text for c in interface.children] == [
+        "switchport trunk allowed vlan 1-3,5,7-9"
+    ]
+
+
