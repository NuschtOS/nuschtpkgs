+    remediation = running_config.config_to_get_to(generated_config).dump_simple()
+    assert remediation == (
+        "interface GigabitEthernet1/0/1",
+        "  no switchport trunk allowed vlan 9-5",
+        "  switchport trunk allowed vlan 10,20",
+    )
